# AGENTLENS Environment Configuration
# Copy to .env and fill in values

# Optional LLM API for semantic analysis
# LLM_API_KEY=your-openai-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Analysis Settings
ANALYSIS_TIMEOUT_MS=5000
MAX_SESSIONS_PER_BATCH=100
AI_COST_PER_ANALYSIS=0.0001
